# Shelfwatch environment — placeholders only. Copy to .env and fill locally.
# Never commit .env or real keys.

# sample | live
SAMPLE_MODE=true

# Reasoning backend when SAMPLE_MODE=false: llm
# Meterless Nightshift OpenAI-compatible Runtime (from Nightshift Console)
NIGHTSHIFT_BASE_URL=http://127.0.0.1:REPLACE_PORT
NIGHTSHIFT_API_KEY=REPLACE_WITH_NIGHTSHIFT_RUNTIME_TOKEN
NIGHTSHIFT_MODEL=REPLACE_WITH_NEMOTRON_LANE_ID

# Zetaris Lightning SQL REST (organiser instance or local Docker)
ZETARIS_BASE_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_API_KEY=REPLACE_WITH_GUI_CREATED_KEY
ZETARIS_ORG_ID=1

# HTTP server for POST /run
PORT=8787
HOST=127.0.0.1
