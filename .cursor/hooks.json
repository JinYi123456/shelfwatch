{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Write",
        "command": "node .cursor/hooks/guard.js",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "matcher": "git commit",
        "command": "node .cursor/hooks/guard.js",
        "timeout": 20
      },
      {
        "matcher": "git push",
        "command": "node .cursor/hooks/guard.js",
        "timeout": 20
      }
    ]
  }
}
